# Database (Vercel Postgres / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Heroes Profile API
HEROES_PROFILE_API_KEY=your_heroes_profile_api_key_here

# OpenAI (for AMA coaching feature — o1-mini)
OPENAI_API_KEY=sk-...

# Shared secret for the native client's replay-ingest endpoint (POST /api/replays/ingest).
# The endpoint fails closed (401) when this is unset, so writes are disabled until set.
REPLAY_INGEST_TOKEN=change_me_long_random_string
