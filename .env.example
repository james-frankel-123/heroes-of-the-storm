# Database (Vercel Postgres / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Heroes Profile API
HEROES_PROFILE_API_KEY=your_heroes_profile_api_key_here

# OpenAI (for AMA coaching feature — o1-mini — and the draft-vision recognizer)
OPENAI_API_KEY=sk-...

# Shared secret for the native client's draft-vision endpoint (POST /api/draft-vision).
# Fails closed (401) when unset. Optional VISION_MODEL overrides the default (gpt-4o-mini).
DRAFT_VISION_TOKEN=change_me_long_random_string
# VISION_MODEL=gpt-4o
