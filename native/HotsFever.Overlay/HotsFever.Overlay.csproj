<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HotsFever.Overlay</RootNamespace>
    <!-- Ship the launcher exe under a clear, user-facing name (code namespaces stay). -->
    <AssemblyName>HotS Fever Draft Coach</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (no MSIX): uses the installed Windows App Runtime via the bootstrapper. -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Self-contained: bundle the WindowsAppSDK + .NET runtime so the app does
         not depend on the (older 1.2) runtime installed on the machine, and so
         `dotnet build` (no Visual Studio) can produce a runnable app. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- SINGLE SOURCE OF TRUTH for the shipped version. The installer reads it
         (ISCC /DAppVersion), the app shows it in the header and stamps it into
         draft-watch.log, and the update check compares it against
         public/draft-coach-version.json. Bump it whenever you publish assets —
         a build in the wild that can't name itself can't be supported. -->
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Heroes.ReplayParser" Version="1.2.18" />
    <PackageReference Include="Heroes.StormReplayParser" Version="2.2.1" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="WinUIEx" Version="2.9.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\draft\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Bundle the engine models + stat data into the app so it runs without the
         repo checkout (linked from their source locations, not duplicated). -->
    <Content Include="..\..\public\models\*.onnx" Link="Assets\models\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\src\lib\data\draft-stats-decayed.json;..\..\src\lib\data\compositions.json" Link="Assets\data\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotsFever.DraftEngine\HotsFever.DraftEngine.csproj" />
  </ItemGroup>

</Project>
