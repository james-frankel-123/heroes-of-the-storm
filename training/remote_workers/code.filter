# rsync filter for CODE (run from the repo root). Code and tiny text only;
# no data, checkpoints, caches, builds or secrets.
- .git/
- .env*
- __pycache__/
- node_modules/
- wandb/
- build/
- mcts_runs/
- mcts_runs_partial/
- cache/
- feature_cache/
- logs/
- snapshots/
- checkpoints/
- *.so
- *.o
+ /training/
+ /src/
+ /src/lib/
+ /src/lib/data/
+ /src/lib/data/*.json
+ /src/lib/data/*.ts
- /src/lib/data/**
- /src/lib/*
- /src/*
+ /AGENTS.md
- /*
+ */
+ *.py
+ *.cu
+ *.cuh
+ *.cpp
+ *.h
+ *.hpp
+ *.c
+ *.sh
+ *.md
+ *.toml
+ *.cfg
+ *.service
- *
