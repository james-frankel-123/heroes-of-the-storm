#!/usr/bin/env python3
"""hyp: the proposer's only interface to outcome data (talks to the broker socket).

  hyp meta                         heroes, maps, roles, kit axes, term types, your dev tranche
  hyp budget                       what you have spent this cycle
  hyp query '<json>' | -f q.json   Q0 (counts) or Q1 (win rates) on S or your dev tranche
  hyp card submit card.yaml        register a hypothesis card (hashed into your ledger)
  hyp card list
  hyp test <card_id>               Q2 nested test on your dev tranche (1.5 bits)
  hyp test-status
  hyp ledger --mine                your released answers

Cycle 2:
  hyp table <card_id> [--hero H] [--top N]   cells of an accepted table, from an S-only fit
                                   of your incumbent (1 sandbox number per cell shown)
  hyp query '{"class":"Q3","mediator":"level_lead_10","group_by":["map_class"]}'
                                   mediator cell means on M-test (mediator bits)
  hyp inspect [--hero H] [--map M] [--interesting|--random]
                                   one M-explore game record (1 of 300 inspection slots)
  hyp mtest <card_id>              mechanism test of a fitted card on M-test (1.5 mediator bits)
"""
import json
import os
import socket
import sys

SOCK = os.environ.get("HYP_BROKER", "/run/hyp/broker.sock")


def call(req):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCK)
    s.sendall((json.dumps(req) + "\n").encode())
    buf = b""
    while not buf.endswith(b"\n"):
        chunk = s.recv(1 << 16)
        if not chunk:
            break
        buf += chunk
    s.close()
    return json.loads(buf)


def _opts(args):
    out, i = {}, 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            if i + 1 < len(args) and not args[i + 1].startswith("--"):
                out[a[2:]] = args[i + 1]
                i += 2
                continue
            out[a[2:]] = True
        i += 1
    return out


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd in ("meta", "budget", "test-status"):
        req = {"op": cmd.replace("-", "_")}
    elif cmd == "query":
        if rest[:1] == ["-f"]:
            q = json.load(open(rest[1]))
        else:
            q = json.loads(rest[0])
        req = {"op": "query", "query": q}
    elif cmd == "card" and rest[:1] == ["submit"]:
        req = {"op": "card_submit", "card": open(rest[1]).read()}
    elif cmd == "card" and rest[:1] == ["list"]:
        req = {"op": "card_list"}
    elif cmd == "test":
        req = {"op": "test", "card_id": rest[0]}
    elif cmd == "ledger":
        req = {"op": "ledger_mine"}
    elif cmd == "table":
        req = {"op": "table", "card_id": rest[0]}
        opts = _opts(rest[1:])
        if "hero" in opts:
            req["hero"] = opts["hero"]
        if "top" in opts:
            req["top"] = int(opts["top"])
    elif cmd == "inspect":
        opts = _opts(rest)
        flt = {k: opts[k] for k in ("hero", "map") if k in opts}
        if "interesting" in opts:
            flt["cohort"] = "interesting"
        if "random" in opts:
            flt["cohort"] = "random"
        req = {"op": "inspect", "filter": flt}
    elif cmd == "mtest":
        req = {"op": "mtest", "card_id": rest[0]}
    else:
        print(__doc__)
        return 2
    resp = call(req)
    print(json.dumps(resp, indent=1))
    return 0 if resp.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
